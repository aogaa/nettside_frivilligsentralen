rules_version = '2';

// All tilgang til Firestore gaar gjennom Cloud Functions (admin-SDK), som ikke
// begrenses av disse reglene. Direkte klienttilgang er derfor helt avslaatt.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
